# ============================================
# Team Alignment Engine - Staging Environment
# Phase D Production-Ready Configuration
# ============================================

# Service Configuration
SERVICE_NAME=team-alignment-engine
SERVICE_VERSION=2.0.0
ENVIRONMENT=staging
LOG_LEVEL=INFO

# Database Configuration
# Production-like PostgreSQL settings for pilot load (15-40 users)
DATABASE_URL=postgresql://tae_user:CHANGEME@staging-db.olumi.com:5432/tae_staging
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Redis Configuration
# Critical for Phase D WebSocket pub/sub and caching
REDIS_URL=redis://staging-redis.olumi.com:6379/0
REDIS_POOL_SIZE=20
REDIS_POOL_MAX_OVERFLOW=10
REDIS_CACHE_TTL=3600

# Phase D: WebSocket Configuration
# Real-time collaboration settings
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS_PER_SESSION=50
WEBSOCKET_IDLE_TIMEOUT=300
WEBSOCKET_MESSAGE_MAX_SIZE=1048576

# Phase D: Analytics Configuration
# Portfolio analytics and pattern caching
ANALYTICS_CACHE_TTL=300
PATTERNS_CACHE_TTL=604800
PORTFOLIO_MAX_SESSIONS=500

# Phase D: Performance Configuration
# Timeout settings for Phase D operations
REQUEST_TIMEOUT=30
DEPENDENCY_GRAPH_TIMEOUT=5
PORTFOLIO_QUERY_TIMEOUT=10

# Phase D: Feature Flags
# Enable/disable Phase D capabilities
FEATURE_PORTFOLIO_ANALYTICS_ENABLED=true
FEATURE_REALTIME_COLLABORATION_ENABLED=true
FEATURE_DECISION_DEPENDENCIES_ENABLED=true
FEATURE_ORGANIZATIONAL_PATTERNS_ENABLED=true
FEATURE_ADVANCED_ANALYTICS_ENABLED=true
FEATURE_CROSS_TEAM_COORDINATION_ENABLED=true

# CEE Integration
# AI-powered assistance for option generation
CEE_BASE_URL=https://cee-staging.olumi.com
CEE_API_KEY=CHANGEME_CEE_API_KEY
CEE_TIMEOUT=60
CEE_USE_MOCK=true  # Set to false when real CEE ready

# ISL Integration
# Causal validation service
ISL_BASE_URL=https://isl-staging.olumi.com
ISL_API_KEY=CHANGEME_ISL_API_KEY
ISL_TIMEOUT=30

# Security
# IMPORTANT: Generate new JWT secret for staging
JWT_SECRET=CHANGEME_GENERATE_SECURE_SECRET_FOR_STAGING
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Monitoring
# Prometheus metrics for Grafana dashboards
PROMETHEUS_PORT=9090
ENABLE_METRICS=true

# CORS
# Staging UI origins
CORS_ORIGINS=https://staging-ui.olumi.com,https://tae-staging.olumi.com

# ============================================
# Deployment Notes:
# ============================================
# 1. Replace all CHANGEME values before deployment
# 2. Generate new JWT_SECRET: openssl rand -hex 32
# 3. Verify DATABASE_URL has correct staging credentials
# 4. Verify REDIS_URL points to staging Redis instance
# 5. Update CORS_ORIGINS to match staging UI domains
# 6. Review all timeout values for staging load profile
# 7. Set CEE_USE_MOCK=false when CEE integration ready
