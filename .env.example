# ============================================================================
# TAE Environment Configuration Template (POC v02)
# ============================================================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control
#
# For PLoT Integration (POC v02), see: docs/PLOT_INTEGRATION_GUIDE.md
# ============================================================================

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================

SERVICE_NAME=team-alignment-engine
SERVICE_VERSION=2.0.0
ENVIRONMENT=development  # development | staging | production
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR

# ============================================================================
# DATABASE
# ============================================================================

# PostgreSQL connection string (asyncpg driver required for async support)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://tae_user:tae_password@localhost:5432/tae_db

# Connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
# Required for Phase D WebSocket and caching
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_POOL_MAX_OVERFLOW=5
REDIS_CACHE_TTL=3600

# Phase D: WebSocket Configuration
# Real-time collaboration settings
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS_PER_SESSION=50
WEBSOCKET_IDLE_TIMEOUT=300
WEBSOCKET_MESSAGE_MAX_SIZE=1048576

# Phase D: Analytics Configuration
# Portfolio analytics and pattern caching
ANALYTICS_CACHE_TTL=300
PATTERNS_CACHE_TTL=604800
PORTFOLIO_MAX_SESSIONS=500

# Phase D: Performance Configuration
# Timeout settings for Phase D operations
REQUEST_TIMEOUT=30
DEPENDENCY_GRAPH_TIMEOUT=5
PORTFOLIO_QUERY_TIMEOUT=10

# Phase D: Feature Flags (POC v02 Priorities)
# Enable/disable Phase D capabilities based on Q6 decision
FEATURE_PORTFOLIO_ANALYTICS_ENABLED=true  # D1 - MUST HAVE (POC v02)
FEATURE_REALTIME_COLLABORATION_ENABLED=false  # D2 - DEFERRED (HTTP polling only)
FEATURE_DECISION_DEPENDENCIES_ENABLED=true  # D3 - MUST HAVE (POC v02)
FEATURE_ORGANIZATIONAL_PATTERNS_ENABLED=true  # D4 - MUST HAVE (POC v02)
FEATURE_ADVANCED_ANALYTICS_ENABLED=false  # D5 - DEFERRED (post-POC)
FEATURE_CROSS_TEAM_COORDINATION_ENABLED=false  # D6 - DEFERRED (post-POC)

# CEE Integration
# AI-powered assistance for option generation
CEE_BASE_URL=https://cee-service.olumi.com
CEE_API_KEY=your_cee_api_key_here
CEE_TIMEOUT=30
CEE_USE_MOCK=true  # Set to false when real CEE ready

# ISL Integration
# Causal validation service
ISL_BASE_URL=https://isl-service.olumi.com
ISL_API_KEY=your_isl_api_key_here
ISL_TIMEOUT=60

# ============================================================================
# PLOT INTEGRATION (POC v02)
# ============================================================================

# Enable PLoT deployment mode (set to true for PLoT-orchestrated deployments)
# Q1 decision: HTTP polling only, no WebSocket proxy
PLOT_DEPLOYMENT_MODE=false

# Internal API key for PLoT → TAE authentication (Q5 decision: API key auth)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# CRITICAL: Must match the key configured in PLoT Engine
PLOT_INTERNAL_API_KEY=your_plot_internal_api_key_here_change_in_production

# Orchestration timeout (seconds) - Target p95 < 10s
PLOT_ORCHESTRATION_TIMEOUT=10

# Enable capability-based filtering (Q2 decision: required for POC v02)
PLOT_CAPABILITY_FILTERING=true

# Security
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Monitoring
PROMETHEUS_PORT=9090
ENABLE_METRICS=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================
# Phase D Capabilities (POC v02 Status):
# ============================================
# D1: Portfolio Analytics ✅ ENABLED (POC v02) - Cross-session insights
# D2: Real-time Collaboration ⏸️ DEFERRED - Use HTTP polling instead
# D3: Decision Dependencies ✅ ENABLED (POC v02) - Graph-based dependency management
# D4: Organizational Patterns ✅ ENABLED (POC v02) - Pattern extraction from retrospectives
# D5: Advanced Analytics ⏸️ DEFERRED - Trend analysis and benchmarking
# D6: Cross-Team Coordination ⏸️ DEFERRED - Multi-team conflict detection
#
# ============================================
# PLoT Integration (POC v02):
# ============================================
# - TAE is internal-only service, orchestrated by PLoT
# - UI → PLoT → TAE (not UI → TAE directly)
# - Single orchestration endpoint: /api/v1/plot/alignment-session
# - Capability-based filtering: PLoT requests specific D1/D3/D4 capabilities
# - Graceful degradation: Partial failures indicated via availability metadata
