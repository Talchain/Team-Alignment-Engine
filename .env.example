# Option 2: Direct Connection (fallback if pooling doesn't work)
# DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.etmmuzwxtcjipwphdola.supabase.co:5432/postgres

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================
# SUPABASE (Optional - for future Supabase Auth integration)
# ============================================
SUPABASE_URL=https://etmmuzwxtcjipwphdola.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV0bW11end4dGNqaXB3cGhkb2xhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Mzg1MjczODIsImV4cCI6MjA1NDEwMzM4Mn0.QEPZS6OKIJBzlUKBNKHh25nRjRUzSpJzXyiZxHPr78k
SUPABASE_SERVICE_KEY=sb_secret_F4fMrE6w37VtfpMN-_EmcQ_lMbP3Xty

# ============================================
# REDIS (Required for caching)
# ============================================
# Choose one option:

# Option 1: Local Redis (for development)
REDIS_URL=redis://localhost:6379

# Option 2: Upstash Redis (free tier - recommended for production)
# Sign up at https://upstash.com, create a Redis database, and paste the connection string
# REDIS_URL=rediss://default:[password]@[endpoint].upstash.io:6379

REDIS_POOL_SIZE=10
REDIS_CACHE_TTL=3600

# ============================================
# SECURITY (JWT Authentication)
# ============================================
JWT_SECRET=4c509e331eae7c06750f07d146e239195dbbbe1325ed74cdd0503515ea0a5a0f
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# APPLICATION SETTINGS
# ============================================
SERVICE_NAME=team-alignment-engine
SERVICE_VERSION=2.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================
# CORS (Frontend URLs)
# ============================================
# Add your frontend URL(s) here (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ============================================
# EXTERNAL SERVICES (Mock mode for MVP)
# ============================================
# CEE (Causal Evidence Engine)
CEE_BASE_URL=https://mock-cee.example.com
CEE_API_KEY=mock-key
CEE_USE_MOCK=true
CEE_TIMEOUT=30

# ISL (Invariant Sufficiency Learning)
ISL_BASE_URL=https://mock-isl.example.com
ISL_API_KEY=mock-key
ISL_TIMEOUT=60

# ============================================
# LLM INTEGRATION (Optional - for synthesis)
# ============================================
# If you want real LLM synthesis (not mocked), add your OpenAI key
# OPENAI_API_KEY=sk-...

# ============================================
# PHASE D FEATURES (WebSocket, Analytics)
# ============================================
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS_PER_SESSION=50
WEBSOCKET_IDLE_TIMEOUT=300
WEBSOCKET_MESSAGE_MAX_SIZE=1048576

ANALYTICS_CACHE_TTL=300
PATTERNS_CACHE_TTL=604800
PORTFOLIO_MAX_SESSIONS=500

REQUEST_TIMEOUT=30
DEPENDENCY_GRAPH_TIMEOUT=5
PORTFOLIO_QUERY_TIMEOUT=10

# Feature flags
FEATURE_PORTFOLIO_ANALYTICS_ENABLED=true
FEATURE_REALTIME_COLLABORATION_ENABLED=false
FEATURE_DECISION_DEPENDENCIES_ENABLED=true
FEATURE_ORGANIZATIONAL_PATTERNS_ENABLED=true
FEATURE_ADVANCED_ANALYTICS_ENABLED=false
FEATURE_CROSS_TEAM_COORDINATION_ENABLED=false

# ============================================
# MONITORING (Optional)
# ============================================
PROMETHEUS_PORT=9090
ENABLE_METRICS=true

# ============================================
# PLOT INTEGRATION (POC v02 - Optional)
# ============================================
PLOT_DEPLOYMENT_MODE=false
PLOT_INTERNAL_API_KEY=
PLOT_ORCHESTRATION_TIMEOUT=10
PLOT_CAPABILITY_FILTERING=true
