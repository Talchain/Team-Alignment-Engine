# Service Configuration
SERVICE_NAME=team-alignment-engine
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://tae_user:tae_password@localhost:5432/tae_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_CACHE_TTL=3600

# CEE Integration
CEE_BASE_URL=https://cee-service.olumi.com
CEE_API_KEY=your_cee_api_key_here
CEE_TIMEOUT=30

# ISL Integration
ISL_BASE_URL=https://isl-service.olumi.com
ISL_API_KEY=your_isl_api_key_here
ISL_TIMEOUT=60

# Security
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Monitoring
PROMETHEUS_PORT=9090
ENABLE_METRICS=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
